# Repo-root build context for docker/Dockerfile.*
# Keep Dockerfiles lean: exclude unrelated trees when possible via path COPY,
# but still ignore secrets and heavy artifacts at root.

.git
.github
**/.DS_Store
**/.idea
**/.vscode

# Secrets
.env
.env.*
!.env.example
secrets/
**/*.pem
**/*.key
**/kubeconfig
**/kubeconfig-*

# Docs & assets not needed in app images
docs/
*.md
!docker/README.md

# Frontend junk when building backend (and vice versa handled by path COPY)
frontend/node_modules
frontend/.next
frontend/out
backend/build
backend/.gradle
backend/bin
backend/out

# Future IaC
.terraform/
*.tfstate*
