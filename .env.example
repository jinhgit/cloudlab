# CloudLab — copy to .env and fill values. Never commit .env.

# --- Platform ---
CLOUDLAB_ENV=local
TZ=Asia/Seoul

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# JWT (generate a long random secret)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION_MS=86400000

# Default admin (change in real deployments)
CLOUDLAB_ADMIN_USERNAME=admin
CLOUDLAB_ADMIN_PASSWORD=change-me

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cloudlab
POSTGRES_USER=cloudlab
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Docker Engine (API container only) ---
DOCKER_HOST=unix:///var/run/docker.sock

# --- Kubernetes ---
# KUBECONFIG path inside API container or host
KUBECONFIG=/home/cloudlab/.kube/config

# --- Observability endpoints (Platform API →) ---
PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
ALERTMANAGER_URL=http://localhost:9093

# --- GitHub (deployments page / Actions) ---
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Notifications ---
DISCORD_WEBHOOK_URL=

# --- Cloudflare (optional docs / automation) ---
CLOUDFLARE_TUNNEL_TOKEN=
