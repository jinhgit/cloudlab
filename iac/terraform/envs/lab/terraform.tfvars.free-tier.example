# Free Tier–oriented lab values (still not a billing guarantee).
# Copy:
#   cp terraform.tfvars.free-tier.example terraform.tfvars
#
# Rules enforced by scripts/iac-free-check.sh:
#   - instance_type: t2.micro | t3.micro only
#   - use_eip: false
#   - root_volume_gb <= 20

aws_region        = "ap-northeast-2"
availability_zone = "ap-northeast-2a"
name_prefix       = "cloudlab-free"
key_name          = "REPLACE_WITH_YOUR_KEYPAIR"

# Free Tier candidates (confirm current AWS Free Tier docs for your account)
instance_type  = "t3.micro"
root_volume_gb = 8
use_eip        = false
enable_compute = true

# REQUIRED for safety: replace with your public IP/32
# curl -s https://checkip.amazonaws.com
allowed_ssh_cidrs  = ["0.0.0.0/0"] # TODO: change to "x.x.x.x/32"
allowed_http_cidrs = ["0.0.0.0/0"]
